# --- IMAP account 1 ---------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
# Gmail/Outlook: use an app password, not the account password
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX

# --- More accounts: same names with a number. Host/port/mailbox fall back. ---
# IMAP_USER2=other@example.com
# IMAP_PASSWORD2=another-app-password

# --- S3 (or any S3-compatible store) -----------------------------------------
S3_BUCKET=aimap
# S3_PREFIX=mail
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Worker ------------------------------------------------------------------
# POLL_INTERVAL_SECONDS=60
# INITIAL_FETCH_COUNT=100
# BATCH_SIZE=25
# LOG_FORMAT=text
