# --- S3 (or any S3-compatible store) -----------------------------------------
S3_BUCKET=aimap
# S3_PREFIX=mail
# S3_ENDPOINT_URL=https://s3.example.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Postgres ---------------------------------------------------------------
# Required. Holds checkpoints, message metadata, the job queue and labels.
DATABASE_URL=postgresql://aimap:aimap@localhost:5432/aimap

# --- Accounts ----------------------------------------------------------------
# Encrypts the passwords in the bucket's accounts file. Generate: aimap keygen
# Keep it out of the bucket. Losing it means re-adding every password.
AIMAP_SECRET_KEY=
# ACCOUNTS_PATH=config/accounts.json

# Quick alternative: one fixed account from env vars, no accounts file.
# Setting IMAP_USER switches ACCOUNTS_SOURCE to env automatically.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-app-password
# IMAP_MAILBOX=INBOX

# --- Worker ------------------------------------------------------------------
# POLL_INTERVAL_SECONDS=60
# INITIAL_FETCH_COUNT=100
# BATCH_SIZE=25
# LOG_FORMAT=text

# --- Classifier (aimap classify) ---------------------------------------------
# JEV_API_KEY=
# JEV_MODEL=jev-1.13.0
# CLASSIFY_CONCURRENCY=4
# CLASSIFY_MAX_ATTEMPTS=5

# --- API (aimap api) -----------------------------------------------------------
# The Firebase project the app signs in to, and who may use the API.
# FIREBASE_PROJECT_ID=
# AIMAP_ALLOWED_EMAILS=you@example.com
# PORT=8080
